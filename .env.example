# Primary bring-your-own reference profile
VOICE_PROVIDER=azure-voice-live
AGENT_PROVIDER=foundry
AZURE_TOKEN_CREDENTIALS=AzureCliCredential
AZURE_TENANT_ID=<set-outside-source-control>
AZURE_VOICE_LIVE_ENDPOINT=<set-outside-source-control>
AZURE_VOICE_LIVE_MODEL=<set-outside-source-control>
FOUNDRY_PROJECT_ENDPOINT=<set-outside-source-control>
FOUNDRY_MODEL_DEPLOYMENT=<set-outside-source-control>
FOUNDRY_AGENT_NAME=<set-outside-source-control>
FOUNDRY_AGENT_VERSION=<set-outside-source-control>

# Credential-free test/documentation profile:
# VOICE_PROVIDER=off
# AGENT_PROVIDER=deterministic
