{
  "$defs": {
    "AppendListItemOperation": {
      "additionalProperties": false,
      "description": "Append a classified value; the service creates the stable item ID.",
      "properties": {
        "operationId": {
          "format": "uuid",
          "title": "Operationid",
          "type": "string"
        },
        "op": {
          "const": "append_list_item",
          "title": "Op",
          "type": "string"
        },
        "section": {
          "enum": [
            "supportingSignals",
            "stakeholders",
            "assumptionsAndUncertainties",
            "missingEvidence",
            "recommendedNextActions"
          ],
          "title": "Section",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ClassifiedText"
        }
      },
      "required": [
        "operationId",
        "op",
        "section",
        "value"
      ],
      "title": "AppendListItemOperation",
      "type": "object"
    },
    "CancellationPhase": {
      "description": "Point at which cancellation completed.",
      "enum": [
        "queued",
        "running"
      ],
      "title": "CancellationPhase",
      "type": "string"
    },
    "ClaimClassification": {
      "description": "Allowed provenance classification for every opportunity claim.",
      "enum": [
        "synthetic_evidence",
        "inference",
        "unknown"
      ],
      "title": "ClaimClassification",
      "type": "string"
    },
    "ClassifiedText": {
      "additionalProperties": false,
      "description": "A claim and its explicit provenance.",
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/ClaimClassification"
        },
        "sourceLabel": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcelabel"
        }
      },
      "required": [
        "text",
        "classification"
      ],
      "title": "ClassifiedText",
      "type": "object"
    },
    "DocumentCommittedEvent": {
      "additionalProperties": false,
