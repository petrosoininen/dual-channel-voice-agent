{
  "analyzers": {
    "core": {
      "enabled": true,
      "rules": {
        "no-hardcoded-env-urls": {
          "level": "error"
        },
        "no-unnecessary-dependson": {
          "level": "error"
        },
        "outputs-should-not-contain-secrets": {
          "level": "error"
        },
        "secure-secrets-in-params": {
          "level": "error"
        },
        "use-parent-property": {
          "level": "error"
        }
      }
    }
  }
}
