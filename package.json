{
  "name": "dual-channel-voice-agent-pattern",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.mjs",
    "test:contracts": "python -m pytest -q tests/contract",
    "test:skills": "python -m pytest -q tests/repository/test_agent_skills.py",
    "validate:release": "python -m scripts.validate_release",
    "test:e2e": "playwright test",
    "test:live-browser": "node scripts/live_browser_smoke.mjs",
    "latency:collect": "node --experimental-strip-types scripts/collect_acknowledgment_samples.mjs",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
