          "const": "document.committed",
          "title": "Type",
          "type": "string"
        },
        "documentId": {
          "format": "uuid",
          "title": "Documentid",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "document": {
          "$ref": "#/$defs/OpportunityDocument"
        },
        "markdownProjection": {
          "maxLength": 16000,
          "title": "Markdownprojection",
          "type": "string"
        },
        "sourceLabels": {
          "default": [],
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Sourcelabels",
          "type": "array"
        },
