        "baseVersion",
        "version",
        "patch"
      ],
      "title": "DocumentPatchEvent",
      "type": "object"
    },
    "DocumentPatchProposal": {
      "additionalProperties": false,
      "description": "Complete atomic semantic patch proposal.",
      "properties": {
        "patchId": {
          "format": "uuid",
          "title": "Patchid",
          "type": "string"
        },
        "sessionId": {
          "format": "uuid",
          "title": "Sessionid",
          "type": "string"
        },
        "turnId": {
          "format": "uuid",
          "title": "Turnid",
          "type": "string"
        },
        "documentId": {
          "format": "uuid",
          "title": "Documentid",
          "type": "string"
        },
        "baseVersion": {
          "minimum": 0,
          "title": "Baseversion",
          "type": "integer"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "append_list_item": "#/$defs/AppendListItemOperation",
                "remove_list_item": "#/$defs/RemoveListItemOperation",
                "replace_section": "#/$defs/ReplaceSectionOperation",
                "set_field": "#/$defs/SetFieldOperation",
                "update_list_item": "#/$defs/UpdateListItemOperation"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SetFieldOperation"
              },
              {
                "$ref": "#/$defs/ReplaceSectionOperation"
              },
              {
                "$ref": "#/$defs/AppendListItemOperation"
              },
              {
                "$ref": "#/$defs/UpdateListItemOperation"
              },
              {
                "$ref": "#/$defs/RemoveListItemOperation"
              }
            ]
          },
          "maxItems": 32,
          "title": "Operations",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "patchId",
        "sessionId",
        "turnId",
        "documentId",
        "baseVersion",
        "summary",
        "operations"
      ],
      "title": "DocumentPatchProposal",
      "type": "object"
    },
