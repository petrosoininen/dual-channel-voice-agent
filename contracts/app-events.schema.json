    "OpportunityDocument": {
      "additionalProperties": false,
      "description": "Canonical, bounded opportunity document projection.",
      "properties": {
        "documentId": {
          "format": "uuid",
          "title": "Documentid",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DocumentStatus"
        },
        "customerGoal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassifiedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentSituation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassifiedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "opportunityHypothesis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassifiedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "supportingSignals": {
          "items": {
            "$ref": "#/$defs/DocumentListItem"
          },
          "maxItems": 24,
          "title": "Supportingsignals",
          "type": "array"
        },
        "expectedValue": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassifiedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "stakeholders": {
          "items": {
            "$ref": "#/$defs/DocumentListItem"
          },
          "maxItems": 16,
          "title": "Stakeholders",
          "type": "array"
        },
        "assumptionsAndUncertainties": {
          "items": {
            "$ref": "#/$defs/DocumentListItem"
          },
          "maxItems": 24,
          "title": "Assumptionsanduncertainties",
          "type": "array"
        },
        "missingEvidence": {
          "items": {
            "$ref": "#/$defs/DocumentListItem"
          },
          "maxItems": 24,
          "title": "Missingevidence",
          "type": "array"
        },
        "recommendedNextActions": {
          "items": {
            "$ref": "#/$defs/DocumentListItem"
          },
          "maxItems": 24,
          "title": "Recommendednextactions",
          "type": "array"
        },
        "confidenceAndRationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassifiedText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "documentId",
        "version",
        "title",
        "status",
        "customerGoal",
        "currentSituation",
        "opportunityHypothesis",
        "supportingSignals",
        "expectedValue",
        "stakeholders",
        "assumptionsAndUncertainties",
        "missingEvidence",
        "recommendedNextActions",
        "confidenceAndRationale"
      ],
      "title": "OpportunityDocument",
      "type": "object"
    },
